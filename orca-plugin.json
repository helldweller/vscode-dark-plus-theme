{
  "manifestVersion": 2,
  "id": "vscode-dark-plus-full",
  "name": "VS Code Dark+ (full)",
  "version": "0.1.0",
  "description": "Full port of VS Code Dark+: app UI, syntax and terminal colors.",
  "license": "MIT",
  "repository": "https://github.com/helldweller/vscode-dark-plus-theme",
  "engines": {
    "orca": ">=1.4.246"
  },
  "execution": "data",
  "contributes": {
    "themes": [
      {
        "id": "dark-plus",
        "title": "VS Code Dark+ (full)",
        "path": "themes/dark.json"
      }
    ],
    "terminalThemes": [
      {
        "id": "dark-plus",
        "title": "VS Code Dark+ (full)",
        "path": "terminal/dark.json"
      }
    ]
  }
}
